    "source": "import {ConvexBody,ConvexContactWorld,contactBox} from './src/engine/convex-contact.ts';\nfor (const staged of [false,true]) {\n  const w=new ConvexContactWorld();\n  const a=w.add(new ConvexBody(contactBox([.05,.05,.05]),[-.1,0,0]));\n  const b=w.add(new ConvexBody(contactBox([.05,.05,.05]),[0,0,0]));\n  const wall=w.add(new ConvexBody(contactBox([.002,1,1]),[.15,0,0],1,false));\n  for(const x of [a,b,wall]) { x.friction=0; x.restitution=1; }\n  a.velocity=[60,0,0];\n  if(staged) w.externalForces=()=>{};\n  w.step(1/120,32);\n  console.log(JSON.stringify({staged,bX:b.position[0],velocity:b.velocity,stats:w.stats}));\n}\n",
