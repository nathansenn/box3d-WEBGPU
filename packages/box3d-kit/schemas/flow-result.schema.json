    },
    "moment": {
     "$ref": "#/$defs/vec3",
     "description": "N m about forces.about"
    }
   },
   "required": [
    "force",
    "moment"
   ],
   "additionalProperties": false
  },
  "extreme": {
   "type": "object",
   "properties": {
    "value": {
     "type": "number"
    },
    "cp": {
     "type": "number"
    },
    "at": {
     "$ref": "#/$defs/vec3"
    }
   },
   "required": [
    "value",
    "at"
   ],
   "additionalProperties": true
  }
 },
 "type": "object",
