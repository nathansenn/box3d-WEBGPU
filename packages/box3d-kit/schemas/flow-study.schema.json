     "required": [
      "kind",
      "center",
      "normal",
      "radius"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "kind": {
       "const": "rect"
      },
      "center": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 3
