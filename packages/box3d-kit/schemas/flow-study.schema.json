    },
    "positions": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "description": "x, y, z per vertex, metres."
    },
    "indices": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "description": "Three vertex indices per triangle. Without it every three vertices are a triangle."
    },
    "file": {
     "type": "string",
     "description": "A mesh file instead of positions (.stl, .obj or .json with positions and indices), relative to the study file. Resolved by the CLI, or by options.loadMesh."
    },
    "thickness": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "Thickness of an open surface (a panel), metres. Closed components ignore it."
